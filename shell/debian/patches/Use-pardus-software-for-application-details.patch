From: Fatih Altun <fatih.altun@pardus.org.tr>
Date: Thu, 20 Nov 2025 14:28:35 +0300
Subject: Use pardus-software for application details

---
 js/ui/appMenu.js | 15 ++++-----------
 1 file changed, 4 insertions(+), 11 deletions(-)

diff --git a/js/ui/appMenu.js b/js/ui/appMenu.js
index f23ae60..f82d5b7 100644
--- a/js/ui/appMenu.js
+++ b/js/ui/appMenu.js
@@ -81,16 +81,9 @@ export class AppMenu extends PopupMenu.PopupMenu {
 
         this.addMenuItem(new PopupMenu.PopupSeparatorMenuItem());
 
-        this._detailsItem = this.addAction(_('App Details'), async () => {
-            const id = this._app.get_id();
-            const args = GLib.Variant.new('(ss)', [id, '']);
-            const bus = await Gio.DBus.get(Gio.BusType.SESSION, null);
-            bus.call(
-                'org.gnome.Software',
-                '/org/gnome/Software',
-                'org.gtk.Actions', 'Activate',
-                new GLib.Variant('(sava{sv})', ['details', [args], null]),
-                null, 0, -1, null);
+        this._detailsItem = this.addAction(_('App Details'), async () => {
+            this._animateLaunch();
+            Gio.Subprocess.new(["/usr/bin/pardus-software", "--details", this._app.get_id()], 0);
             Main.overview.hide();
         });
 
@@ -180,7 +173,7 @@ export class AppMenu extends PopupMenu.PopupMenu {
     }
 
     _updateDetailsVisibility() {
-        const sw = this._appSystem.lookup_app('org.gnome.Software.desktop');
+        const sw = this._appSystem.lookup_app('tr.org.pardus.software.desktop');
         this._detailsItem.visible = sw !== null;
     }
 
