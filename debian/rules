#!/usr/bin/make -f

DPKG_EXPORT_BUILDFLAGS = 1
include /usr/share/dpkg/default.mk

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

# Kabuk, gnome-shell 48'in bir çatalıdır. gnome-shell paketini gölgelememesi
# için kendi prefix'inde durur; GDM'i, yardımcı servisleri ve çatalın paylaştığı
# GSettings şemalarını hâlâ o paket sağlar.
prefix := /usr/lib/vatan-shell
builddir := build-vatan
pkgroot := $(CURDIR)/debian/vatan

%:
	dh $@

override_dh_auto_configure:
	meson setup $(builddir) shell \
		--wrap-mode=nodownload \
		--buildtype=plain \
		--prefix=$(prefix) \
		--libdir=lib \
		--libexecdir=libexec \
		--sysconfdir=/etc \
		--localstatedir=/var \
		-Dextensions_tool=false \
		-Dextensions_app=false \
		-Dman=false \
		-Dgtk_doc=false \
		-Dportal_helper=false \
		-Dtests=false \
		-Dnetworkmanager=true \
		-Dsystemd=true

override_dh_auto_build:
	meson compile -C $(builddir)

override_dh_auto_test:

override_dh_auto_install:
	DESTDIR=$(CURDIR)/debian/tmp meson install -C $(builddir) --no-rebuild

override_dh_auto_clean:
	rm -rf $(builddir)

override_dh_install:
	dh_install
	install -Dm644 data/session/vatan.desktop $(pkgroot)/usr/share/wayland-sessions/vatan.desktop
	install -Dm644 data/session/vatan-xorg.desktop $(pkgroot)/usr/share/xsessions/vatan.desktop
	install -Dm644 data/session/vatan.session $(pkgroot)/usr/share/gnome-session/sessions/vatan.session
	install -Dm644 data/session/org.vatan.Shell.desktop $(pkgroot)/usr/share/applications/org.vatan.Shell.desktop
	install -Dm644 data/session/gnome-session@vatan.target.d/vatan.session.conf \
		$(pkgroot)/usr/lib/systemd/user/gnome-session@vatan.target.d/vatan.session.conf
	install -Dm644 -t $(pkgroot)/usr/lib/systemd/user \
		data/session/org.vatan.Shell.target \
		data/session/org.vatan.Shell@wayland.service \
		data/session/org.vatan.Shell@x11.service
	install -Dm644 data/90_vatan.gschema.override $(pkgroot)/usr/share/glib-2.0/schemas/90_vatan.gschema.override
	install -Dm644 data/org.vatan.shell.gschema.xml $(pkgroot)/usr/share/glib-2.0/schemas/org.vatan.shell.gschema.xml
	install -Dm644 data/applications/vatan-nsosyal.desktop $(pkgroot)/usr/share/applications/vatan-nsosyal.desktop
	install -Dm644 data/applications/org.vatan.Settings.desktop $(pkgroot)/usr/share/applications/org.vatan.Settings.desktop
	install -Dm644 settings/vatan-settings.js $(pkgroot)/usr/share/vatan/settings/vatan-settings.js
	dpkg-parsechangelog -S Version > $(pkgroot)/usr/share/vatan/version
	install -Dm644 -t $(pkgroot)/usr/share/fonts/truetype/vatan data/fonts/*.ttf
	install -Dm644 -t $(pkgroot)/usr/share/backgrounds/vatan data/backgrounds/*.png
	install -Dm644 data/backgrounds/vatan.xml $(pkgroot)/usr/share/gnome-background-properties/vatan.xml
	install -Dm644 data/icons/VATAN/index.theme $(pkgroot)/usr/share/icons/VATAN/index.theme
	install -Dm644 -t $(pkgroot)/usr/share/icons/VATAN/places data/icons/VATAN/places/*.svg
	install -Dm644 -t $(pkgroot)/usr/share/icons/VATAN/apps data/icons/VATAN/apps/*.svg
	install -Dm644 -t $(pkgroot)/usr/share/plymouth/themes/vatan data/plymouth/vatan/*
	install -Dm755 data/login/vatan-login-screen $(pkgroot)/usr/lib/vatan/vatan-login-screen

# Upstream kurulumunun geri kalanı (desktop dosyaları, D-Bus servisleri, şemalar,
# systemd birimleri) gnome-shell'in sistem için zaten sunduklarının kopyasıdır.
override_dh_missing:
	dh_missing --list-missing

override_dh_shlibdeps:
	dh_shlibdeps -l$(pkgroot)$(prefix)/lib/gnome-shell
