#!/bin/sh
set -e

# VATAN kabuğu olmadan, etkin bir giriş ekranı override'ı GDM'in artık var
# olmayan bir binary'yi başlatmasına yol açar; paketle birlikte kaldır.
if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    home=$(getent passwd Debian-gdm | cut -d: -f6 || true)
    override="$home/.local/share/applications/org.gnome.Shell.desktop"
    if [ -n "$home" ] && [ -f "$override" ] && grep -q "/usr/lib/vatan-shell/" "$override"; then
        rm -f "$override"
    fi
fi

#DEBHELPER#
